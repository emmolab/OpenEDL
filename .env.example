# Optional emergency/recovery access for the management API.
ADMIN_TOKEN=

# Break-glass local administrator sign-in while SSO is enforced. Disabled by
# default; enable only through the deployment environment when it is required.
EMERGENCY_LOCAL_AUTH_ENABLED=false

# SQLite database location. The Docker image sets this to /data/openedl.sqlite.
# Local development defaults to ./data/openedl.sqlite.
DATABASE_PATH=

# Directory for verified SQLite backups created from Maintenance. Defaults to
# a backups directory beside DATABASE_PATH (/data/backups in Docker).
DATABASE_BACKUP_DIR=

# Host port used by compose.yaml.
OPENEDL_PORT=3000

# Required in production when forwarded host headers do not contain the public URL.
AUTH_BASE_URL=https://edl.example.com

# Restrict management access. Leave both empty to allow any successfully
# authenticated account from a configured provider.
AUTH_ALLOWED_DOMAINS=example.com
AUTH_ALLOWED_EMAILS=

# Required to create SSO providers or authenticated EDL API connections
# through the management GUI. Generate with:
# openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# Google OIDC
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Microsoft Entra ID OIDC. The directory tenant UUID is required.
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_TENANT_ID=

# Additional OIDC providers. Store this as a secret because it contains client
# secrets. Each issuer must use HTTPS.
OIDC_PROVIDERS_JSON=[]

# Optional for Docker's built-in scheduler, which generates an internal token
# when this is blank. Set a stable value only when an external scheduler needs
# to invoke /api/cron/refresh.
CRON_SECRET=
