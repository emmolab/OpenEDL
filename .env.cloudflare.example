# Wrangler authentication (omit when using `wrangler login`)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare resources
CLOUDFLARE_WORKER_NAME=openedl
CLOUDFLARE_D1_DATABASE_NAME=openedl
CLOUDFLARE_D1_DATABASE_ID=

# Optional ignored file containing application secrets for Wrangler to upload
CLOUDFLARE_SECRETS_FILE=.env.cloudflare-secrets
